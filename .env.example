# Copy to .env.local and fill in. Only these values are read by the client.

# Base URL of the PizzaHub backend (no trailing slash).
#   local backend:    http://localhost:5000
#   deployed backend: https://<your-server>.vercel.app
# Auth, orders, vendor and admin calls are proxied through this site to it
# (see next.config.ts), and the public menu pages fetch from it directly.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:5000

# Optional. Overrides the base URL used by the public menu pages only.
# NEXT_PUBLIC_API_URL=

# The backend must allow this site's origin (its CLIENT_URL / EXTRA_ALLOWED_ORIGINS),
# otherwise sign-in and other cookie requests fail with 403 ORIGIN_NOT_ALLOWED.
#
# No Stripe or Better Auth secret is needed here: payments and auth run on the backend.

# Optional. Footer contact details (demo values are used when these are not set).
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_CONTACT_PHONE=
# NEXT_PUBLIC_CONTACT_ADDRESS=
